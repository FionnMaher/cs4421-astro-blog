---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const gameCards = [
	{ name: 'Snake', type: 'snake', details: 'Use the arrow keys to eat food and keep growing.', href: '/demo/snake', image: '/game-images/snake.jpeg' },
	{ name: 'Game 2', type: 'placeholder', details: 'A new game demo will be available here in the future.', href: '#', image: '' },
	{ name: 'Game 3', type: 'placeholder', details: 'A new game demo will be available here in the future.', href: '#', image: '' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Demo | ${SITE_TITLE}`} description="Play a browser-based Snake game." />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 960px;
				margin: 0 auto;
				padding: 2em 0;
			}
			.intro {
				margin-bottom: 2em;
				text-align: center;
			}
			.games {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: 1.5em;
			}
			.game-card {
				overflow: hidden;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				background: white;
				box-shadow: var(--box-shadow);
			}
			.game-link {
				display: block;
				color: inherit;
				text-decoration: none;
			}
			.game-image {
				display: block;
				width: 100%;
				height: 180px;
				object-fit: cover;
				background: #dff7a5;
			}
			.game-placeholder {
				display: grid;
				min-height: 180px;
				place-items: center;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				font-size: 1.25em;
			}
			.game-details {
				padding: 1em;
			}
			.game-details h2,
			.game-details p {
				margin: 0;
			}
			.game-details p {
				margin-top: 0.5em;
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>Game Demo</h1>
				<p>Try the first playable game below.</p>
			</section>
			<section class="games" aria-label="Game demos">
				{gameCards.map((game) => (
					<article class="game-card">
						{game.type === 'snake' ? (
							<a class="game-link" href={game.href}>
								<img class="game-image" src={game.image} alt="Snake game preview" />
							</a>
						) : (
							<div class="game-placeholder" aria-hidden="true">Coming soon</div>
						)}
						<div class="game-details">
							<h2>{game.name}</h2>
							<p>{game.details}</p>
						</div>
					</article>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>
